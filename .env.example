DATABASE_URL=postgresql://dtrust:dtrust_local_dev@localhost:5432/dtrust
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Canonical public origin (scheme + host, no trailing slash) used to build the
# GitHub OAuth callback URL: <ORIGIN>/login/github/callback. Defaults to
# http://localhost:5173 for local dev. In PROD set this to your real domain
# (e.g. https://your-domain) and register the matching callback in the GitHub
# OAuth app. See RELEASE-BATON.md.
ORIGIN=
# Optional: server token (PAT / GitHub App) for GitHub API user lookups in prod.
# Unauthenticated is 60 req/hr per IP — fine for local dev.
GITHUB_TOKEN=
# Comma-separated GitHub logins promoted to system admin on login. Admins mint
# roots and reach /admin; everyone else cannot. Config is the source of truth —
# admin survives DB resets and stays in sync (drop a handle here => demoted on
# next login). Leave empty for none.
ADMIN_GITHUB_HANDLES=
# Optional: Discord incoming-webhook URL. When set, the site announces events
# (new signups, new vouches, root mints) to that channel. Unset = silently no
# notifications (fine for local dev / previews). Create one in Discord under
# Server Settings -> Integrations -> Webhooks -> New Webhook -> Copy URL. In
# PROD set this in the Vercel project env. A webhook outage never breaks the
# user flow — notifications are best-effort.
DISCORD_WEBHOOK_URL=
# Master key (32 bytes, base64) that envelope-encrypts identity signing keys at
# rest, so a DB read alone can't forge vouches (S1). Lives ONLY here / in the
# runtime env — NEVER in the database. Generate with:
#   openssl rand -base64 32
# REQUIRED: minting/claiming an identity and signing a vouch fail loudly without
# it. After setting it in prod and deploying, run `bun scripts/encrypt-keys.ts`
# once to seal any pre-existing plaintext keys. Rotating it requires re-sealing
# every row (decrypt with old, seal with new) — keep it stable.
KEY_ENCRYPTION_KEY=
